{
  "manifest_version": 3,
  "name": "CodeSync",
  "short_name": "CodeSync",
  "version": "1.0.0",
  "description": "Automatically sync your accepted LeetCode and GeeksforGeeks solutions to GitHub.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "CodeSync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "identity", "alarms", "notifications"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content/leetcode-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content/leetcode.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.geeksforgeeks.org/problems/*", "https://practice.geeksforgeeks.org/problems/*"],
      "js": ["content/gfg-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.geeksforgeeks.org/problems/*", "https://practice.geeksforgeeks.org/problems/*"],
      "js": ["content/gfg.js"],
      "run_at": "document_start"
    }
  ]
}
