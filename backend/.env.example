# ─── CodeSync backend configuration ────────────────────────────────────────
# Copy to backend/.env for local development. NEVER commit real values.
# In production set these in your host's environment settings (Render, Railway, Fly…).

NODE_ENV=development
HOST=0.0.0.0
PORT=8787

# Public origin of this backend. GitHub redirects to ${PUBLIC_URL}/v1/auth/callback.
# Must be https:// in production.
PUBLIC_URL=http://localhost:8787

# GitHub App → Settings → General → "Client ID" (starts with Iv…)
GITHUB_APP_CLIENT_ID=
# GitHub App → Settings → General → Client secrets → "Generate a new client secret"
GITHUB_APP_CLIENT_SECRET=
# The app's URL slug: https://github.com/apps/<slug>
GITHUB_APP_SLUG=

# 32 random bytes, base64. Generate with:  npm run keys:generate
# Seals sessions (which carry the encrypted GitHub token). Rotating it signs everyone out.
TOKEN_ENCRYPTION_KEY=

# Comma-separated Chrome extension IDs allowed to sign in (chrome://extensions → ID).
# Include your unpacked dev ID and the Chrome Web Store ID.
ALLOWED_EXTENSION_IDS=fpbhganiebeohkggopmldnpibhfndfbe

SESSION_TTL_DAYS=30
# true when running behind a reverse proxy / load balancer (Render, Fly, Railway)
TRUST_PROXY=false
LOG_LEVEL=info
